# ─── Runtime ─────────────────────────────────────────────
NODE_ENV=development

# ─── Database ────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/gtechglobal_os

# ─── Cache / Queue ───────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── Auth ────────────────────────────────────────────────
JWT_SECRET=replace-with-a-64-char-random-string
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace-with-another-64-char-random-string
JWT_REFRESH_EXPIRES_IN=7d

# ─── App URLs ────────────────────────────────────────────
API_PORT=4000
WEB_URL=http://localhost:3000
API_URL=http://localhost:4000

# ─── AI Providers ────────────────────────────────────────
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ─── G Wash Integration ──────────────────────────────────
GWASH_API_URL=https://api.gwash.ng
GWASH_API_KEY=
GWASH_WEBHOOK_SECRET=

# ─── Object Storage (S3 compatible) ──────────────────────
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=gtechglobal-docs
